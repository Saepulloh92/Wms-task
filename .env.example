# Salin ke .env.local (tidak ikut git). Semua opsional; bisa juga diisi lewat menu Data > Sinkron di aplikasi.
# CATATAN: nilai VITE_* ikut tertanam di bundel JS publik. Pakai repo + hosting privat, atau biarkan kosong
# dan isi URL/token dari menu aplikasi di tiap perangkat.
VITE_SYNC_URL=https://script.google.com/macros/s/ISI_DEPLOYMENT_ID/exec
VITE_SYNC_TOKEN=ISI_API_TOKEN
VITE_CLEARING_URL=https://script.google.com/macros/s/ISI_DEPLOYMENT_ID/exec
VITE_DELIVERY_URL=
VITE_MON_URL=
